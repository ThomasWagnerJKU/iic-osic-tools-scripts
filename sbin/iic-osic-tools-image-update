#!/bin/bash
# ========================================================================
# Pulls or updates the IIC-OSIC-TOOLS image in the shared read-only image
# store, which all users of iic-osic-tools run their containers from.
#
# The store belongs to user eda (rootless Podman). force_mask = "shared"
# stores all image files readable for everyone and keeps the real modes
# and owners in an extended attribute, which fuse-overlayfs applies in
# the containers. Afterwards the store metadata is made readable too.
#
# Afterwards it lists the users whose running containers still use an
# older image of the store; "--check" only does that, without pulling.
#
# Usage: iic-osic-tools-image-update [--check] [image]   (as eda, or as root)
#
# SPDX-FileCopyrightText: 2026 Thomas Wagner, Johannes Kepler University
# SPDX-License-Identifier: Apache-2.0
# ========================================================================

STORE="/var/local/eda/images"
STORE_USER="eda"
CHECK_ONLY=0
if [ "${1:-}" = "--check" ]; then
    CHECK_ONLY=1
    shift
fi
IMAGE="${1:-docker.io/hpretl/iic-osic-tools:latest}"

# Run as the owner of the store, also when called by root
if [ "$(id -un)" != "$STORE_USER" ]; then
    if [ "$(id -u)" != 0 ]; then
        echo "[ERROR] Please run as $STORE_USER or root."
        exit 1
    fi
    exec sudo -u "$STORE_USER" XDG_RUNTIME_DIR="/run/user/$(id -u "$STORE_USER")" "$0" "$@"
fi

# Without a systemd user session (e.g. via sudo) Podman falls back to a
# runtime directory in /tmp, which breaks after a reboot
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ ! -d "$XDG_RUNTIME_DIR" ]; then
    echo "[ERROR] $XDG_RUNTIME_DIR does not exist, enable lingering for $STORE_USER (loginctl enable-linger $STORE_USER)."
    exit 1
fi

# The same storage options on every call (the store was created with this
# runroot, Podman refuses others), layers pulled without
# force_mask would not be readable for the other users
PODMAN=(podman --root "$STORE" --runroot "$XDG_RUNTIME_DIR/containers"
        --storage-opt overlay.mount_program=/usr/bin/fuse-overlayfs
        --storage-opt overlay.force_mask=shared)

# List the users whose containers run an image of the store other than
# $1 (an image ID). Rootless containers are invisible to other users, but
# their fuse-overlayfs process is not: its first lowerdir is the link of
# the image's top layer, which images.json maps to the image.
_list_outdated () {
    local current="$1" user args link img found=0
    declare -A image_of
    while read -r img layer; do
        [ -r "$STORE/overlay/$layer/link" ] && image_of[$(cat "$STORE/overlay/$layer/link")]=$img
    done < <(jq -r '.[] | "\(.id) \(.layer)"' "$STORE/overlay-images/images.json")

    while read -r user args; do
        link=$(grep -oE "lowerdir=$STORE/overlay/l/[A-Z0-9]+" <<< "$args" | head -1 | sed 's|.*/l/||')
        [ -n "$link" ] || continue
        img=${image_of[$link]:-}
        [ -n "$img" ] && [ "$img" != "$current" ] || continue
        [ "$found" = 0 ] && echo "[INFO] Containers still running an older image (restart them to update):"
        found=1
        echo "       $user: image ${img:0:12}"
    done < <(ps -eo user:64=,args= | awk '$2 == "/usr/bin/fuse-overlayfs"')

    if [ "$found" = 0 ]; then
        echo "[INFO] No container runs an older image of the store."
        return 0
    fi
    echo "[HINT] Users restart with \"iic-osic-tools stop\" and \"iic-osic-tools start\"."
    return 1
}

if [ "$CHECK_ONLY" = 1 ]; then
    CURRENT_ID=$("${PODMAN[@]}" image inspect --format '{{.Id}}' "$IMAGE" 2>/dev/null)
    if [ -z "$CURRENT_ID" ]; then
        echo "[ERROR] $IMAGE is not in the store."
        exit 1
    fi
    _list_outdated "$CURRENT_ID"
    exit 0
fi

OLD_ID=$("${PODMAN[@]}" image inspect --format '{{.Id}}' "$IMAGE" 2>/dev/null)
if ! "${PODMAN[@]}" pull "$IMAGE"; then
    echo "[ERROR] Pulling $IMAGE failed."
    exit 1
fi
NEW_ID=$("${PODMAN[@]}" image inspect --format '{{.Id}}' "$IMAGE")

# Store directories and metadata are created 0700/0600
if ! chmod -R a+rX "$STORE"; then
    echo "[ERROR] Could not make $STORE readable for all users."
    exit 1
fi

if [ "$OLD_ID" = "$NEW_ID" ]; then
    echo "[INFO] $IMAGE is up to date."
else
    echo "[INFO] $IMAGE updated to ${NEW_ID:0:12}."
fi
if ! _list_outdated "$NEW_ID"; then
    echo "[HINT] Remove old images only when no container uses them any more (see \"$0 --check\"):"
    echo "[HINT]   ${PODMAN[*]} rmi <image>"
fi
